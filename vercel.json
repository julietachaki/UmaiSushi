{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/u/index.html" },
    { "source": "/orden", "destination": "/u/orden.html" },
    { "source": "/u/:slug", "destination": "/u/index.html" },
    { "source": "/u/:slug/pedido", "destination": "/u/pedido.html?slug=:slug" },
    { "source": "/u/:slug/orden", "destination": "/u/orden.html?slug=:slug" }
  ],
  "redirects": [
    {
      "source": "/pedido.html",
      "destination": "/u/umai/pedido",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
